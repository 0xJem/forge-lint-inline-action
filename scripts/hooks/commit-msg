#!/usr/bin/env bash
set -euo pipefail

subject="$(sed -n '1p' "$1")"
pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9][a-z0-9._-]*\))?!?: .+$'

if [[ "$subject" =~ $pattern ]]; then
  exit 0
fi

cat >&2 <<'EOF'
Commit subject must use Conventional Commit style:

  type(scope): summary
  type!: breaking summary

Allowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test
Examples:
  feat: add inline annotations
  fix(parser): handle nested diagnostics
  ci!: change release approval flow
EOF

exit 1
